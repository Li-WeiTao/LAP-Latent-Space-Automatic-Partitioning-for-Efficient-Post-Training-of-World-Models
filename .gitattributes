* text=auto

# Source and documentation use stable Unix line endings.
*.py text eol=lf
*.sh text eol=lf
*.R text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf

# Migrated result tables and logs are immutable experiment artifacts.
*.csv -text
*.json -text
*.txt -text
*.log -text
*.out -text

# Binary experiment artifacts and figures.
*.npz binary
*.npy binary
*.h5 binary
*.pt binary
*.pth binary
*.ckpt binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ipynb -text
