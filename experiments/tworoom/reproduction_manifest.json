{
  "schema_version": 1,
  "scope": "TwoRoom experiments from trajectory deviation onward",
  "required_environment": {
    "LAP_TWOROOM_DATA": "Absolute path to tworoom.h5",
    "LAP_LEWM_CHECKPOINT": "Absolute path to the official LeWM checkpoint",
    "GPU": "Physical CUDA device id"
  },
  "profiles": {
    "main": [
      "main_matrix"
    ],
    "analysis": [
      "trajectory_deviation",
      "trajectory_switch",
      "probe_rooms3",
      "probe_priority5",
      "partition_stability"
    ],
    "ablations": [
      "manual_epoch_sweep",
      "step_routing",
      "encoding_equivalence"
    ],
    "full": [
      "main_matrix",
      "trajectory_deviation",
      "trajectory_switch",
      "probe_rooms3",
      "probe_priority5",
      "partition_stability",
      "manual_epoch_sweep",
      "step_routing",
      "encoding_equivalence"
    ]
  },
  "experiments": [
    {
      "id": "main_matrix",
      "tier": "canonical",
      "description": "Official, Joint-Continue 3ep, Global-FT50, Random-Voronoi K3-50, K-means++ K3-50, Spectral K3-50, and human rooms3-50.",
      "command": "bash experiments/tworoom/scripts/run_tworoom_main_matrix.sh",
      "required_env": ["LAP_TWOROOM_DATA", "LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": [
        "experiments/tworoom/matrix/tworoom_main_summary.json",
        "experiments/tworoom/matrix/tworoom_main_summary.csv"
      ]
    },
    {
      "id": "trajectory_deviation",
      "tier": "analysis",
      "description": "Regional versus global open-loop latent trajectory deviation.",
      "command": "bash experiments/tworoom/scripts/run_geometry_trajectory_deviation.sh",
      "required_env": ["LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": ["experiments/tworoom/results/tworoom_geometry_trajectory_deviation_*/*"]
    },
    {
      "id": "trajectory_switch",
      "tier": "analysis",
      "description": "Four-way predictor-switch rollout analysis.",
      "command": "bash experiments/tworoom/scripts/run_trajectory_switch_rollout_4way.sh",
      "required_env": ["LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": ["experiments/tworoom/results/tworoom_trajectory_switch_rollout_4way/*"]
    },
    {
      "id": "probe_rooms3",
      "tier": "analysis",
      "description": "Five-seed linear and RFF probe for rooms3 latent separability.",
      "command": "bash experiments/tworoom/scripts/run_geometry_latent_probe_rooms3_multiseed.sh",
      "required_env": ["GPU"],
      "outputs": ["experiments/tworoom/results/geometry_latent_probe_rooms3_multiseed/*"]
    },
    {
      "id": "probe_priority5",
      "tier": "analysis",
      "description": "Five-seed linear and RFF probe for priority5 latent separability.",
      "command": "bash experiments/tworoom/scripts/run_geometry_latent_probe_priority5_multiseed.sh",
      "required_env": ["GPU"],
      "outputs": ["experiments/tworoom/results/geometry_latent_probe_priority5_multiseed/*"]
    },
    {
      "id": "partition_stability",
      "tier": "analysis",
      "description": "Preprocessing, K-means++ restart, Random-Voronoi, and landmark spectral stability studies.",
      "command": "bash experiments/tworoom/scripts/run_tworoom_partition_stability.sh",
      "required_env": ["GPU"],
      "outputs": [
        "experiments/tworoom/results/latent_kmeanspp_multirestart_k3/*",
        "experiments/tworoom/results/latent_random_voronoi_k3/*",
        "experiments/tworoom/results/latent_landmark_spectral_k3/*"
      ]
    },
    {
      "id": "manual_epoch_sweep",
      "tier": "ablation",
      "description": "rooms3/priority5 30/50/80-epoch and doorway-specific manual-partition ablations.",
      "command": "bash experiments/tworoom/scripts/run_tworoom_manual_epoch_ablations.sh",
      "required_env": ["LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": ["experiments/tworoom/results/tworoom_success_rate_*ep_*"]
    },
    {
      "id": "step_routing",
      "tier": "ablation",
      "description": "Per-imagined-step routing compared with the main per-MPC routing protocol.",
      "command": "bash experiments/tworoom/scripts/run_success_rate_latent_kmeanspp_step_routing_longrange_all_outer.sh",
      "required_env": ["LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": ["experiments/tworoom/results/*step_routing*"]
    },
    {
      "id": "encoding_equivalence",
      "tier": "validation",
      "description": "Lossless unique-timestep encoding and legacy-loader equivalence checks.",
      "command": "python experiments/tworoom/validate_embedding_loader.py --sample-size 1024 --batch-size 128 --workers 4 --device cuda",
      "required_env": ["LAP_TWOROOM_DATA", "LAP_LEWM_CHECKPOINT", "GPU"],
      "outputs": ["experiments/tworoom/results/embedding_loader_validation/validation.json"]
    }
  ]
}
